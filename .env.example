# ========================================
# LightBot 环境变量模板
# ========================================
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按本机实际账号密码填写
#   3. IDE 启动时通过 EnvFile 插件 / Spring Boot 启动配置注入
#   4. 生产环境通过 docker-compose env_file 或 K8s Secret 注入
#
# .env 已加入 .gitignore，请勿提交实际密码到代码仓库

# ========================================
# PostgreSQL
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lightbot
DB_USERNAME=postgres
DB_PASSWORD=<your-pg-password>

# 只读账号（用于 PgSqlTool，限制权限）
# 创建语句：CREATE ROLE lightbot_readonly LOGIN PASSWORD 'xxx' NOSUPERUSER NOCREATEDB NOCREATEROLE;
# GRANT USAGE ON SCHEMA public TO lightbot_readonly;
# GRANT SELECT ON ALL TABLES IN SCHEMA public TO lightbot_readonly;
DB_READONLY_USERNAME=lightbot_readonly
DB_READONLY_PASSWORD=<your-readonly-password>

# ========================================
# Redis
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password>
REDIS_DATABASE=9

# ========================================
# MinIO
# ========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<your-access-key>
MINIO_SECRET_KEY=<your-secret-key>
MINIO_BUCKET=lightbot

# ========================================
# Neo4j
# ========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# ========================================
# Milvus（向量库，未部署设为 false）
# ========================================
MILVUS_ENABLED=false
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# ========================================
# SpringAI 模型密钥
# ========================================
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ========================================
# 内置工具 API Key（可选）
# ========================================
GITHUB_TOKEN=
TAVILY_API_KEY=
SILICONFLOW_API_KEY=

# ========================================
# Swagger（生产建议 false）
# ========================================
SWAGGER_ENABLED=false

# ========================================
# CORS 允许的前端源（生产环境填实际域名，多个用逗号分隔）
# ========================================
CORS_ALLOWED_ORIGINS=https://lightbot.example.com
